// Add ids to <a name="..."> elements so :target can highlight sections
(function() {
  var anchors = document.querySelectorAll('a[name]');
  anchors.forEach(function(a) {
    var name = a.getAttribute('name');
    if (name && !a.id) {
      a.id = name;
    }
  });
})();
</script>

